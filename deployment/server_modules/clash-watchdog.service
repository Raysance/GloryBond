[Unit]
Description=Clash proxy connectivity and subscription maintenance
After=network-online.target clash.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/root/miniconda3/bin/python3.13 /srv/modules/clash/ops/clash_watchdog.py --settings /srv/modules/clash/config/watchdog.json
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
