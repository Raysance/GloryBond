[Unit]
Description=HOK QQBot NapCat QQ client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@STACK_ROOT@
EnvironmentFile=@NBOT_ROOT@/.env
Environment=BOT_PATH=@NBOT_ROOT@
Environment=HOK_CONFIG_FILE=@NBOT_ROOT@/config.yaml
ExecStart=@NAPCAT_RUNNER@
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
UMask=0027

[Install]
WantedBy=multi-user.target
