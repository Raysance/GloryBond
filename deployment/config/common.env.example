# Shared HOK runtime configuration. The installer replaces @...@ placeholders.
HOK_STACK_ROOT=@STACK_ROOT@
BOT_PATH=@NBOT_ROOT@
WEB_PATH=@WEB_ROOT@
HOK_CONFIG_FILE=@CONFIG_DIR@/config.yaml
HOK_STATIC_VARIABLES_FILE=@CONFIG_DIR@/variables_static.json
HOK_DYNAMIC_VARIABLES_FILE=@CONFIG_DIR@/variables_dynamic.json
REDIS_CONF=@CONFIG_DIR@/redis.json
HOK_DATA_DIR=@STATE_DIR@/data
HOK_FILE_TRANSFER_DIR=@STATE_DIR@/file_transfer
HOK_LOG_DIR=@LOG_DIR@/nbot
HOK_DATABASE_DSN="REDACTED_CREDENTIAL"
HOK_WEB_HOST=127.0.0.1
HOK_WEB_PORT=8000
HOK_REDIS_BACKUP_DIR=@STATE_DIR@/backups/redis

# Set these only when this host needs an outbound proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# SJTU chat uses its own VPN proxy, independent of the global proxy above.
# Set the real key in the private host environment, never in source control.
HOK_CHAT_API_KEY=replace-me
HOK_CHAT_PROXY_URL=socks5h://10.203.0.2:1080
# HOK_CHAT_BASE_URL=https://models.sjtu.edu.cn/api/v1
# HOK_CHAT_MODEL=deepseek-chat
# Optional override for variables_static.json openrouter_api_key.
# HOK_OPENROUTER_API_KEY=
# HOK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# HOK_OPENROUTER_SEARCH_MODEL=openrouter/auto
# HOK_OPENROUTER_SEARCH_ENGINE=auto

# Optional override for the dedicated Steam and APIMart Clash route.
# HOK_CLASH_PROXY_URL=socks5h://127.0.0.1:7891
