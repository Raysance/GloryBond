# Public repository safety boundary.
# Root rules protect secrets and private runtime data from the public showcase repo.
# Subproject .gitignore files should only ignore local caches, generated files, and other unnecessary artifacts.

# Python/runtime caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Secrets and environment files
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/config.yaml
**/config.local.yaml
**/config.*.yaml
!**/config.example.yaml
!**/config.sample.yaml
!**/config.template.yaml
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.secret
*.secrets
*secret*
*token*
*credential*

# Private bot configuration and user data
**/variables_static.json
**/variables_dynamic.json
**/emojiref.json
NBot/data/*
!NBot/data/honor/
NBot/data/honor/*
!NBot/data/honor/districts.json
NBot/file_transfer/
NBot/log/
Web/log/
**/.venv/
**/build/
**/dist/
**/*.egg-info/
.DS_Store
**/.DS_Store
**/redis-migration-backups/
NBot/deployment/
NBot/deploy_runner.sh
NBot/.github/
Web/.github/

# Logs may contain private identifiers or request details
*.log
logs/
**/logs/
